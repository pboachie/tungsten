<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Tungsten.Runtime</RootNamespace>
    <AssemblyName>Tungsten.Runtime</AssemblyName>
    <PackageId>Tungsten.Runtime</PackageId>
    <Version>0.1.3</Version>
    <Authors>Prince Boachie</Authors>
    <Description>The runtime of the C# SDKs generated by tungsten: pre-flight validation, auth, idempotency, confirmation, retries, classification into the diagnostic envelope, previews, pagination, macros and server-sent event streams.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>tungsten-icon.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pboachie/tungsten</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pboachie/tungsten</RepositoryUrl>
    <PackageTags>tungsten;sdk;runtime;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="LICENSE" Pack="true" PackagePath="" />
    <None Include="../../assets/tungsten-icon.png" Link="tungsten-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
