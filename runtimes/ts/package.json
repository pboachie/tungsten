{
  "name": "@elysra/tungsten-runtime",
  "version": "0.1.3",
  "description": "Runtime for SDKs generated by tungsten: transport, retries, idempotency, diagnostic error envelopes, previews and pagination.",
  "keywords": ["openapi", "sdk", "tungsten", "agents", "runtime", "typescript"],
  "homepage": "https://github.com/pboachie/tungsten",
  "repository": {"type": "git", "url": "git+https://github.com/pboachie/tungsten.git", "directory": "runtimes/ts"},
  "bugs": {"url": "https://github.com/pboachie/tungsten/issues"},
  "author": "Prince Boachie",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
