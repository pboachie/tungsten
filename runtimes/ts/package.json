{
  "name": "@tungsten/runtime",
  "version": "0.1.0",
  "description": "Runtime for SDKs generated by tungsten: transport, retries, idempotency, diagnostic error envelopes, previews and pagination.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" }
  },
  "files": ["dist", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
