# frozen_string_literal: true
# SPDX-License-Identifier: Apache-2.0

require_relative "lib/tungsten/runtime/version"

Gem::Specification.new do |spec|
  spec.name = "tungsten-runtime"
  spec.version = Tungsten::Runtime::VERSION
  spec.authors = ["Prince Boachie"]
  spec.summary = "The runtime of Ruby SDKs generated by tungsten"
  spec.description = "Pre-flight validation, auth, idempotency, confirmation, retries, error classification, " \
                     "previews, pagination, macros and server-sent event streams for SDKs generated by tungsten."
  spec.homepage = "https://github.com/pboachie/tungsten"
  spec.license = "Apache-2.0"
  spec.files = Dir["lib/**/*.rb"] + ["LICENSE", "README.md"]
  spec.require_paths = ["lib"]
  spec.required_ruby_version = ">= 3.3"
  spec.metadata["rubygems_mfa_required"] = "true"
  spec.metadata["source_code_uri"] = "https://github.com/pboachie/tungsten/tree/main/runtimes/ruby"
end
