<!-- SPDX-License-Identifier: Apache-2.0 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Tungsten.Runtime.FSharp</RootNamespace>
    <AssemblyName>Tungsten.Runtime.FSharp</AssemblyName>
    <PackageId>Tungsten.Runtime.FSharp</PackageId>
    <Version>0.1.4</Version>
    <Authors>Prince Boachie</Authors>
    <Description>The F# layer of the SDKs generated by tungsten over the .NET runtime Tungsten.Runtime: the F# identity, Patch as a union, Result and option interop, task and async-sequence helpers and the JSON helpers of generated records. Transport and semantics are Tungsten.Runtime's.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pboachie/tungsten</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pboachie/tungsten</RepositoryUrl>
    <PackageTags>tungsten;sdk;runtime;agents;fsharp</PackageTags>
    <!-- FSharp.Core is pinned to the version the .NET SDK 10.0.401 bundles (its library pack). -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <TungstenRuntime Condition="'$(TungstenRuntime)' == ''">../csharp/Tungsten.Runtime.csproj</TungstenRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Identity.fs" />
    <Compile Include="src/Patch.fs" />
    <Compile Include="src/Interop.fs" />
    <Compile Include="src/Results.fs" />
    <Compile Include="src/Codec.fs" />
    <Compile Include="src/Tasks.fs" />
    <Compile Include="src/Calls.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TungstenRuntime)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
