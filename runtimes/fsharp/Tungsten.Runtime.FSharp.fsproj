<!-- SPDX-License-Identifier: Apache-2.0 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Tungsten.Runtime.FSharp</RootNamespace>
    <AssemblyName>Tungsten.Runtime.FSharp</AssemblyName>
    <PackageId>Tungsten.Runtime.FSharp</PackageId>
    <Version>0.1.5</Version>
    <Authors>Prince Boachie</Authors>
    <Description>The F# layer of the SDKs generated by tungsten over the .NET runtime Tungsten.Runtime: the F# identity, Patch as a union, Result and option interop, task and async-sequence helpers and the JSON helpers of generated records. Transport and semantics are Tungsten.Runtime's.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>tungsten-icon.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pboachie/tungsten</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pboachie/tungsten</RepositoryUrl>
    <PackageTags>tungsten;sdk;runtime;agents;fsharp</PackageTags>
    <!-- FSharp.Core 10.1.401 is the published dependency floor, independent of SDK patch upgrades.
         Restore obtains this exact package when the SDK library pack contains a newer version.
         The nuspec asks for FSharp.Core 10.1.401 or higher, resolved from nuget.org by consumers. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestoreSources Condition="'$(TungstenRuntimeFeed)' != ''">$(TungstenRuntimeFeed)</RestoreSources>
    <TungstenRuntime Condition="'$(TungstenRuntime)' == ''">../csharp/Tungsten.Runtime.csproj</TungstenRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Identity.fs" />
    <Compile Include="src/Patch.fs" />
    <Compile Include="src/Interop.fs" />
    <Compile Include="src/Results.fs" />
    <Compile Include="src/Codec.fs" />
    <Compile Include="src/Tasks.fs" />
    <Compile Include="src/Calls.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
  </ItemGroup>

  <!-- Development and CI build the F# layer against the C# runtime source. A release pack
       sets TungstenRuntimeFeed to a folder holding the same-version Tungsten.Runtime package
       so the packed nuspec depends on exactly that version, [Version], not on "Version or higher". -->
  <ItemGroup Condition="'$(TungstenRuntimeFeed)' == ''">
    <ProjectReference Include="$(TungstenRuntime)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TungstenRuntimeFeed)' != ''">
    <PackageReference Include="Tungsten.Runtime" Version="[$(Version)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
    <None Include="../../assets/tungsten-icon.png" Link="tungsten-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
